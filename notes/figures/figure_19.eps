[0.5 0 0 0.5 0 0] CT
[1 0 0 1 0 0] CT
N
0 0 M
1120 0 L
1120 840 L
0 840 L
0 0 L
cp
clip
GS
0 0 translate
1120 840 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 840
  /ImageMatrix [1120 0 0 840 0 0]
  /Width 1120
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
